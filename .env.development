# Copy this file's contents into a real ".env" file and fill in real values before deploying.
# The app runs out-of-the-box with these defaults (SQLite DB, dev-mode email, Razorpay test keys).

APP_NAME=AI Precision Healthcare Platform
APP_ENV=development
DEBUG=True

DATABASE_URL=sqlite:///./app/database/healthcare.db
# Production example: mysql+pymysql://user:password@localhost:3306/healthcare_db

JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:7000","http://127.0.0.1:7000"]

FREE_PREDICTIONS_LIMIT=2
FREE_SYMPTOM_CHECKS_LIMIT=2

# Set both values in production to generate LLM-authored clinical reports.
# Keep OPENAI_API_KEY server-side; do not expose it to the frontend.
LLM_ENABLED=False
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

RAZORPAY_KEY_ID=rzp_test_TJ35euKcpxOr9h
RAZORPAY_KEY_SECRET=jUIAvq4u8OQR0gUVR9pJzF34
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
PREMIUM_MONTHLY_PRICE_INR=49900
PREMIUM_YEARLY_PRICE_INR=399900

EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@precisionhealth.ai

MAX_UPLOAD_SIZE_MB=10
