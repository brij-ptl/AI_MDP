# =============================================================================
# Nidaan+ — Environment Configuration
# =============================================================================
# Copy this file to ".env" and fill in real values before running.
# The application runs out-of-the-box with these defaults for local development
# (SQLite database, log-only email, Razorpay test keys).
#
# NEVER commit the real ".env" file to version control.
# NEVER expose this file or its values to the frontend.
# =============================================================================


# =============================================================================
# Application
# =============================================================================
APP_NAME=AI Precision Healthcare Platform
# APP_ENV controls logging verbosity and error detail exposure.
# Options: development | staging | production
APP_ENV=development
# Set DEBUG=False in production to prevent traceback exposure in error responses.
DEBUG=True


# =============================================================================
# Server
# =============================================================================
HOST=0.0.0.0
PORT=8000


# =============================================================================
# Database
# =============================================================================
# Defaults to local SQLite — works out of the box for development.
# For production, use MySQL or PostgreSQL:
#   MySQL:      mysql+pymysql://user:password@localhost:3306/nidaan_db
#   PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/nidaan_db
DATABASE_URL=sqlite:///./app/database/healthcare.db


# =============================================================================
# Security / JWT
# =============================================================================
# CRITICAL: Replace with a long, cryptographically random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_THIS_SECRET_IN_PRODUCTION_ENV_FILE

JWT_ALGORITHM=HS256
# Access token lifetime in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie names (do not change unless you update the frontend accordingly)
COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
TRACKING_COOKIE_NAME=phc_tracking_id

# CRITICAL: Set COOKIE_SECURE=True in production (requires HTTPS).
# With COOKIE_SECURE=False, cookies are sent over plain HTTP.
COOKIE_SECURE=False
# SameSite policy: "lax" works for same-domain deployments.
# Use "none" only for cross-origin setups (requires COOKIE_SECURE=True).
COOKIE_SAMESITE=lax


# =============================================================================
# CORS
# =============================================================================
# List of allowed frontend origins. Must match exactly (including port).
# In production, set this to your actual frontend domain only.
# Example for production: ["https://app.yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:7000","http://127.0.0.1:7000"]


# =============================================================================
# Business Rules
# =============================================================================
# Number of free predictions a user gets before the paywall activates.
FREE_PREDICTIONS_LIMIT=2
# Number of free AI symptom checks before the paywall activates.
FREE_SYMPTOM_CHECKS_LIMIT=2


# =============================================================================
# Payment — Razorpay
# =============================================================================
# Sign up at https://dashboard.razorpay.com to get your API keys.
# Test keys (rzp_test_*) are safe to use in development — no real money moves.
# Replace with live keys (rzp_live_*) for production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME
# Webhook secret — set this to a strong random string and configure the same
# value in your Razorpay Dashboard webhook settings.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Subscription plan prices in paise (1 INR = 100 paise).
# Example: 4900 paise = INR 49.00
STARTER_PRICE_INR=4900
CARE_PLUS_PRICE_INR=14900
FAMILY_PRICE_INR=39900
ANNUAL_PRICE_INR=99900

# Legacy pricing fields retained for backwards compatibility.
PREMIUM_MONTHLY_PRICE_INR=14900
PREMIUM_YEARLY_PRICE_INR=99900


# =============================================================================
# Email (SMTP)
# =============================================================================
# If EMAIL_ENABLED=False, all emails are logged to stdout instead of being sent.
# Safe for local development. Set to True in production with real SMTP credentials.
EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# For Gmail: use an App Password (not your account password).
# See: https://support.google.com/accounts/answer/185833
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@precisionhealth.ai


# =============================================================================
# File Storage
# =============================================================================
# Directory where uploaded OCR files are temporarily stored.
UPLOAD_DIR=app/uploads
# Maximum file size for OCR uploads in megabytes.
MAX_UPLOAD_SIZE_MB=10
# Allowed file extensions for OCR uploads.
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".png",".jpg",".jpeg"]
# Directory where generated PDF reports are saved.
GENERATED_REPORTS_DIR=app/static/generated_reports


# =============================================================================
# Machine Learning
# =============================================================================
# Directory where trained model .joblib files are stored.
TRAINED_MODELS_DIR=trained_models
# Directory where training datasets are downloaded/cached.
DATASETS_DIR=datasets
# Directory containing per-disease config.json files.
ML_CONFIG_DIR=app/ml/diseases


# =============================================================================
# Clinical Narrative LLM (Optional)
# =============================================================================
# When LLM_ENABLED=False (default), clinical explanations are generated
# deterministically from feature importances — no external API call, fully
# offline and reproducible.
# When LLM_ENABLED=True, an OpenAI API call is made to generate richer
# narrative. The API key must be kept server-side only.
LLM_ENABLED=False
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
# Timeout for OpenAI API calls in seconds.
LLM_TIMEOUT_SECONDS=60


# =============================================================================
# Rate Limiting
# =============================================================================
# Maximum number of API requests per IP address per minute.
# Requests exceeding this limit receive HTTP 429.
# Note: Current implementation is in-memory and does not share state across
# multiple workers. Use Redis-backed rate limiting for multi-worker production.
RATE_LIMIT_PER_MINUTE=60


# =============================================================================
# OCR — Tesseract
# =============================================================================
# Path to the Tesseract binary.
# If Tesseract is installed normally (on your PATH), leave this as "tesseract".
# Windows example (if not on PATH):
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract
