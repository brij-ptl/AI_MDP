APP_NAME=Nidaan+ Healthcare Platform
APP_ENV=production
DEBUG=False

# Postgres DB URL (Matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER:-nidaan_user}:${POSTGRES_PASSWORD:-nidaan_password}@nidaan_db:5432/${POSTGRES_DB:-nidaan_db}

# Secure configuration for Docker deployment
JWT_SECRET_KEY=generate-a-secure-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

CORS_ORIGINS=["http://localhost:7000"]

FREE_PREDICTIONS_LIMIT=2
FREE_SYMPTOM_CHECKS_LIMIT=2

LLM_ENABLED=False
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PREMIUM_MONTHLY_PRICE_INR=49900
PREMIUM_YEARLY_PRICE_INR=399900

EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nidaan.ai

MAX_UPLOAD_SIZE_MB=10
